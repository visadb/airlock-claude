#!/bin/bash

set -u

VERBOSE=
[ "${1:-}" = "-v" ] && VERBOSE=1

SUITE_DIR=$(cd "$(dirname "$0")" && pwd)
SCRIPT=$SUITE_DIR/airlock-claude
[ -x "$SCRIPT" ] || { echo "not executable: $SCRIPT" >&2; exit 1; }

TMPROOT=$(mktemp -d "${TMPDIR:-/tmp}/airlock-claude-tests.XXXXXX") || exit 1
trap 'rm -rf "$TMPROOT"' EXIT

PASSED=0
FAILED=0

pass() {
  local label=$1
  PASSED=$((PASSED + 1))
  printf '  ok    %s\n' "$label"
}
fail() {
  local label=$1 detail=${2:-}
  FAILED=$((FAILED + 1))
  printf '  FAIL  %s\n' "$label"
  [ -n "$detail" ] && printf '        %s\n' "$detail"
  return 0
}

section() { local title=$1; printf '\n%s\n' "$title"; }

assert_rc() {
  local expected=$1 actual=$2 label=$3
  if [ "$expected" = "$actual" ]; then pass "$label"
  else fail "$label" "expected exit $expected, got $actual"; fi
}
assert_eq() {
  local expected=$1 actual=$2 label=$3
  if [ "$expected" = "$actual" ]; then pass "$label"
  else fail "$label" "expected [$expected], got [$actual]"; fi
}
assert_grep() {
  local pattern=$1 file=$2 label=$3
  if [ -f "$file" ] && grep -q -- "$pattern" "$file"; then pass "$label"
  else fail "$label" "no match for [$pattern] in $(basename "$file")"; fi
}
assert_not_grep() {
  local pattern=$1 file=$2 label=$3
  if [ ! -f "$file" ]; then fail "$label" "file to search does not exist: $file"
  elif grep -q -- "$pattern" "$file"; then fail "$label" "unexpected match for [$pattern]"
  else pass "$label"; fi
}
assert_exists() {
  local path=$1 label=$2
  if [ -e "$path" ]; then pass "$label"; else fail "$label" "missing: $path"; fi
}
assert_absent() {
  local path=$1 label=$2
  if [ -e "$path" ]; then fail "$label" "should not exist: $path"; else pass "$label"; fi
}

TOOLS=$TMPROOT/tools
mkdir -p "$TOOLS"
for t in sed tail cat rm chmod mkdir ls tr mv; do
  p=$(command -v "$t") || { echo "required tool not found: $t" >&2; exit 1; }
  ln -s "$p" "$TOOLS/$t"
done
p=$(command -v mktemp) && ln -s "$p" "$TOOLS/mktemp"

new_case() {
  CASE_DIR=$(mktemp -d "$TMPROOT/case.XXXXXX")
  BIN=$CASE_DIR/bin
  WORK=$CASE_DIR/work
  FAKE_HOME=$CASE_DIR/home
  LOG=$CASE_DIR/log
  mkdir -p "$BIN" "$WORK" "$FAKE_HOME"
  : > "$LOG"
  export LOG CASE_DIR
  export STUB_IMAGE_MISSING= STUB_BUILD_FAILS= DF_MODE=root PROBE_DOCKER= DUMP_ARGV=
  export STUB_PTY_DUMP= STUB_EXIT=
  export DEFAULTS_MODE=dark
  unset AIRLOCK_CLAUDE_SKIP_UPDATE AIRLOCK_CLAUDE_THEME COLORFGBG
  RC=0
}

stub_engine() {
  local engine=$1
  cat > "$BIN/$engine" <<EOF
#!/bin/sh
NAME=$engine
EOF
  cat >> "$BIN/$engine" <<'EOF'
case "$1" in
  image) [ -n "${STUB_IMAGE_MISSING:-}" ] && exit 1; exit 0 ;;
  build)
    echo "BUILD($NAME): $*" >> "$LOG"
    cat > "$CASE_DIR/Dockerfile"
    [ -n "${STUB_BUILD_FAILS:-}" ] && exit 1
    exit 0 ;;
esac
echo "$NAME REACHED: $*" >> "$LOG"
exit 0
EOF
  chmod +x "$BIN/$engine"
}

stub_airlock() {
  cat > "$BIN/airlock" <<'EOF'
#!/bin/sh
echo "LAUNCH: $*" >> "$LOG"
echo "LAUNCH_HOME: $HOME" >> "$LOG"
if [ -n "${DUMP_ARGV:-}" ]; then
  for arg; do echo "ARGV[$arg]" >> "$LOG"; done
fi
if [ -n "${PROBE_DOCKER:-}" ]; then
  echo "SHIM_PATH: $(command -v docker)" >> "$LOG"
  docker probe-from-airlock
fi
echo "LAUNCH_PTY_DUMP: ${AIRLOCK_PTY_DUMP:-unset}" >> "$LOG"
if [ -n "${STUB_PTY_DUMP:-}" ]; then
  mkdir -p .airlock/sandbox
  printf '%b' "$STUB_PTY_DUMP" > .airlock/sandbox/pty.dump
fi
exit "${STUB_EXIT:-0}"
EOF
  chmod +x "$BIN/airlock"
}

stub_df() {
  cat > "$BIN/df" <<'EOF'
#!/bin/sh
case "${DF_MODE:-root}" in
  root)                printf 'Mounted on\n/\n' ;;
  separate_filesystem) printf 'Mounted on\n/mnt/data\n' ;;
  bsd_rejects_output)  echo "df: unrecognized option '--output=target'" >&2; exit 1 ;;
  header_only)         printf 'Mounted on\n' ;;
esac
exit 0
EOF
  chmod +x "$BIN/df"
}

stub_git() {
