#!/bin/bash

set -u

VERBOSE=
[ "${1:-}" = "-v" ] && VERBOSE=1

SUITE_DIR=$(cd "$(dirname "$0")" && pwd)
SCRIPT=$SUITE_DIR/airlock-claude
[ -x "$SCRIPT" ] || { echo "not executable: $SCRIPT" >&2; exit 1; }

TMPROOT=$(mktemp -d "${TMPDIR:-/tmp}/airlock-claude-tests.XXXXXX") || exit 1
trap 'rm -rf "$TMPROOT"' EXIT

PASSED=0
FAILED=0

pass() {
  local label=$1
  PASSED=$((PASSED + 1))
  printf '  ok    %s\n' "$label"
}
fail() {
  local label=$1 detail=${2:-}
  FAILED=$((FAILED + 1))
  printf '  FAIL  %s\n' "$label"
  [ -n "$detail" ] && printf '        %s\n' "$detail"
  return 0
}

section() { local title=$1; printf '\n%s\n' "$title"; }

assert_rc() {
  local expected=$1 actual=$2 label=$3
  if [ "$expected" = "$actual" ]; then pass "$label"
  else fail "$label" "expected exit $expected, got $actual"; fi
}
assert_eq() {
  local expected=$1 actual=$2 label=$3
  if [ "$expected" = "$actual" ]; then pass "$label"
  else fail "$label" "expected [$expected], got [$actual]"; fi
}
assert_grep() {
  local pattern=$1 file=$2 label=$3
  if [ -f "$file" ] && grep -q -- "$pattern" "$file"; then pass "$label"
  else fail "$label" "no match for [$pattern] in $(basename "$file")"; fi
}
assert_not_grep() {
  local pattern=$1 file=$2 label=$3
  if [ ! -f "$file" ]; then fail "$label" "file to search does not exist: $file"
  elif grep -q -- "$pattern" "$file"; then fail "$label" "unexpected match for [$pattern]"
  else pass "$label"; fi
}
assert_exists() {
  local path=$1 label=$2
  if [ -e "$path" ]; then pass "$label"; else fail "$label" "missing: $path"; fi
}
assert_absent() {
  local path=$1 label=$2
  if [ -e "$path" ]; then fail "$label" "should not exist: $path"; else pass "$label"; fi
}

TOOLS=$TMPROOT/tools
mkdir -p "$TOOLS"
for t in sed tail cat rm chmod mkdir ls; do
  p=$(command -v "$t") || { echo "required tool not found: $t" >&2; exit 1; }
  ln -s "$p" "$TOOLS/$t"
done
p=$(command -v mktemp) && ln -s "$p" "$TOOLS/mktemp"

new_case() {
  CASE_DIR=$(mktemp -d "$TMPROOT/case.XXXXXX")
  BIN=$CASE_DIR/bin
  WORK=$CASE_DIR/work
  FAKE_HOME=$CASE_DIR/home
  LOG=$CASE_DIR/log
  mkdir -p "$BIN" "$WORK" "$FAKE_HOME"
  : > "$LOG"
  export LOG CASE_DIR
  export STUB_IMAGE_MISSING= STUB_BUILD_FAILS= DF_MODE=root PROBE_DOCKER=
  unset AIRLOCK_CLAUDE_SKIP_UPDATE
  RC=0
}

stub_engine() {
  local engine=$1
  cat > "$BIN/$engine" <<EOF
#!/bin/sh
NAME=$engine
EOF
  cat >> "$BIN/$engine" <<'EOF'
case "$1" in
  image) [ -n "${STUB_IMAGE_MISSING:-}" ] && exit 1; exit 0 ;;
  build)
    echo "BUILD($NAME): $*" >> "$LOG"
    cat > "$CASE_DIR/Dockerfile"
    [ -n "${STUB_BUILD_FAILS:-}" ] && exit 1
    exit 0 ;;
esac
echo "$NAME REACHED: $*" >> "$LOG"
exit 0
EOF
  chmod +x "$BIN/$engine"
}

stub_airlock() {
  cat > "$BIN/airlock" <<'EOF'
#!/bin/sh
echo "LAUNCH: $*" >> "$LOG"
echo "LAUNCH_HOME: $HOME" >> "$LOG"
if [ -n "${PROBE_DOCKER:-}" ]; then
  echo "SHIM_PATH: $(command -v docker)" >> "$LOG"
  docker probe-from-airlock
fi
exit 0
EOF
  chmod +x "$BIN/airlock"
}

stub_df() {
  cat > "$BIN/df" <<'EOF'
#!/bin/sh
case "${DF_MODE:-root}" in
  root)                printf 'Mounted on\n/\n' ;;
  separate_filesystem) printf 'Mounted on\n/mnt/data\n' ;;
  bsd_rejects_output)  echo "df: unrecognized option '--output=target'" >&2; exit 1 ;;
  header_only)         printf 'Mounted on\n' ;;
esac
exit 0
EOF
  chmod +x "$BIN/df"
}

stub_git() {
  cat > "$BIN/git" <<'EOF'
#!/bin/sh
if [ "$1" = config ] && [ "$2" = --list ]; then
  printf 'user.name=Lower Precedence Name\n'
  printf 'user.email=lower-precedence@example.com\n'
  printf 'user.name=Higher Precedence Name\n'
  printf 'user.email=higher-precedence@example.com\n'
  exit 0
fi
exit 0
EOF
  chmod +x "$BIN/git"
}

stub_all() { stub_engine docker; stub_airlock; stub_df; stub_git; }
stub_all_but_airlock() { stub_engine docker; stub_df; stub_git; }
stub_all_but_container_engine() { stub_airlock; stub_df; stub_git; }
stub_all_but_df() { stub_engine docker; stub_airlock; stub_git; }
stub_all_but_docker() { stub_engine podman; stub_airlock; stub_df; stub_git; }

run_script() {
  ( cd "$WORK" && PATH="$BIN:$TOOLS" HOME="$FAKE_HOME" \
      "$SCRIPT" "$@" > "$CASE_DIR/out" 2> "$CASE_DIR/err" )
  RC=$?
  if [ -n "$VERBOSE" ]; then
    [ -s "$CASE_DIR/out" ] && sed 's/^/        out: /' "$CASE_DIR/out"
    [ -s "$CASE_DIR/err" ] && sed 's/^/        err: /' "$CASE_DIR/err"
  fi
  return 0
}

CONFIG() { echo "$WORK/airlock.local.toml"; }

section "syntax"
if bash -n "$SCRIPT" 2>"$TMPROOT/syntax.err"; then
  pass "script parses under bash -n"
else
  fail "script parses under bash -n" "$(cat "$TMPROOT/syntax.err")"
fi

section "argument handling"
new_case; stub_all
run_script --help
assert_rc 0 "$RC" "--help exits 0"
assert_grep "Usage: airlock-claude" "$CASE_DIR/out" "--help prints usage to stdout"
assert_not_grep "LAUNCH:" "$LOG" "--help does not launch"

new_case; stub_all
run_script -h
assert_rc 0 "$RC" "-h exits 0"

new_case; stub_all_but_airlock
run_script --help
assert_rc 0 "$RC" "--help works with airlock absent"

new_case; stub_all
run_script --bogus
assert_rc 2 "$RC" "unknown option exits 2"
assert_grep "unknown option" "$CASE_DIR/err" "unknown option explains itself"

section "dependency checks"
new_case; stub_all_but_airlock
export STUB_IMAGE_MISSING=1
run_script
assert_rc 1 "$RC" "missing airlock exits 1"
assert_grep "airlock not found in PATH" "$CASE_DIR/err" "missing airlock names the dependency"
assert_not_grep "BUILD(" "$LOG" "missing airlock is caught before the build"
assert_absent "$(CONFIG)" "missing airlock writes no config"

new_case; stub_all_but_container_engine
run_script
assert_rc 1 "$RC" "no container engine exits 1"
assert_grep "Neither docker nor podman" "$CASE_DIR/err" "no engine names the dependency"

new_case; stub_all_but_df
run_script
assert_rc 1 "$RC" "no df and no gdf exits 1"
assert_grep "Neither gdf nor df" "$CASE_DIR/err" "no df names the dependency"

section "generated config"
new_case; stub_all
run_script
assert_rc 0 "$RC" "happy path exits 0"
assert_exists "$(CONFIG)" "config is written"
assert_grep 'presets = \["claude-code"\]' "$(CONFIG)" "config declares the claude-code preset"
assert_grep 'policy = "deny-by-default"' "$(CONFIG)" "config denies network by default"
assert_grep 'name = "airlock-claude:latest"' "$(CONFIG)" "config points at the built image"
assert_grep 'DISABLE_AUTOUPDATER = "1"' "$(CONFIG)" "config disables the background autoupdater"
assert_not_grep "AIRLOCK_CLAUDE_SKIP_UPDATE" "$(CONFIG)" "opt-out absent when unset on the host"

new_case; stub_all
export AIRLOCK_CLAUDE_SKIP_UPDATE=1
run_script
assert_grep "AIRLOCK_CLAUDE_SKIP_UPDATE" "$(CONFIG)" "opt-out present when set on the host"
sed -n '/^\[env\]/,$p' "$(CONFIG)" > "$CASE_DIR/env-table"
assert_grep "AIRLOCK_CLAUDE_SKIP_UPDATE" "$CASE_DIR/env-table" "opt-out sits inside the [env] table"

new_case; stub_all
mkdir -p "$WORK/airlock.local.toml"
run_script
assert_rc 1 "$RC" "unwritable config exits 1"
assert_grep "could not write airlock.local.toml" "$CASE_DIR/err" "unwritable config says so"
assert_not_grep "LAUNCH:" "$LOG" "unwritable config does not launch"

section "launch"
new_case; stub_all
run_script
assert_eq "LAUNCH: start --monitor -- tmux -u new-session -A -s claude claude --remote-control" \
  "$(grep '^LAUNCH:' "$LOG")" "launch argv is exact"
assert_not_grep "dangerously-skip-permissions" "$LOG" "launch passes no permission flag"

new_case; stub_all
run_script --monitor
assert_grep "LAUNCH: start --monitor --" "$LOG" "--monitor asks for what is already the default"

new_case; stub_all
run_script --no-monitor
assert_eq "LAUNCH: start -- tmux -u new-session -A -s claude claude --remote-control" \
  "$(grep '^LAUNCH:' "$LOG")" "--no-monitor drops the monitor flag"

new_case; stub_all
run_script -M
assert_not_grep "monitor" "$LOG" "-M is the short form"

new_case; stub_all
run_script --tmux
assert_grep "LAUNCH: start --monitor -- tmux -u new-session -A -s claude claude " "$LOG" \
  "--tmux asks for what is already the default"

new_case; stub_all
run_script --no-tmux
assert_eq "LAUNCH: start --monitor -- claude --remote-control" \
  "$(grep '^LAUNCH:' "$LOG")" "--no-tmux runs claude directly"

new_case; stub_all
run_script -T
assert_not_grep "tmux" "$LOG" "-T is the short form"

new_case; stub_all
run_script -M -T
assert_eq "LAUNCH: start -- claude --remote-control" \
  "$(grep '^LAUNCH:' "$LOG")" "-M and -T together strip both wrappers"

section "image build"
new_case; stub_all
run_script
assert_not_grep "BUILD(" "$LOG" "existing image is not rebuilt"

new_case; stub_all
export STUB_IMAGE_MISSING=1
run_script
assert_grep "BUILD(docker)" "$LOG" "missing image triggers a build"
assert_not_grep "no-cache" "$LOG" "implicit build keeps the layer cache"

new_case; stub_all
run_script -r
assert_grep "no-cache" "$LOG" "-r discards the layer cache"
assert_grep "pull" "$LOG" "-r re-pulls the base image"

new_case; stub_all
export STUB_IMAGE_MISSING=1 STUB_BUILD_FAILS=1
run_script
assert_rc 1 "$RC" "failed build exits 1"
assert_not_grep "LAUNCH:" "$LOG" "failed build does not launch"

new_case; stub_all
export STUB_IMAGE_MISSING=1
run_script
assert_grep "GIT_USER_NAME=Higher Precedence Name" "$LOG" "build takes the last user.name"
assert_grep "GIT_USER_EMAIL=higher-precedence@example.com" "$LOG" "build takes the last user.email"

section "generated Dockerfile"
new_case; stub_all
export STUB_IMAGE_MISSING=1
run_script
assert_exists "$CASE_DIR/Dockerfile" "Dockerfile reaches the build on stdin"
assert_eq "FROM python:3.14-slim" "$(head -1 "$CASE_DIR/Dockerfile")" "Dockerfile starts at the base image"
assert_grep "claude.ai/install.sh" "$CASE_DIR/Dockerfile" "Dockerfile installs Claude Code"
assert_grep "usr/local/bin/claude" "$CASE_DIR/Dockerfile" "Dockerfile writes the updating wrapper"
assert_grep "unzip openssh-client" "$CASE_DIR/Dockerfile" "Dockerfile keeps the base package list"
assert_grep "^ *tmux locales \\\\$" "$CASE_DIR/Dockerfile" "Dockerfile installs tmux and locales, and nothing else"
assert_not_grep "ncurses-term" "$CASE_DIR/Dockerfile" "Dockerfile does not install ncurses-term"
assert_grep "^ENV LANG=en_US.UTF-8$" "$CASE_DIR/Dockerfile" "Dockerfile sets a UTF-8 locale"
assert_grep "en_US.UTF-8 UTF-8' > /etc/locale.gen" "$CASE_DIR/Dockerfile" "Dockerfile seeds locale.gen with that locale"
assert_grep "locale-gen" "$CASE_DIR/Dockerfile" "Dockerfile generates it"
assert_grep "etc/claude-code/managed-settings.json" "$CASE_DIR/Dockerfile" \
  "Dockerfile writes the system Claude Code settings"
assert_grep '"defaultMode": "bypassPermissions"' "$CASE_DIR/Dockerfile" \
  "system settings bypass permission prompts"
assert_grep '"skipDangerousModePermissionPrompt": true' "$CASE_DIR/Dockerfile" \
  "system settings pre-accept the bypass warning"
assert_grep "etc/tmux.conf" "$CASE_DIR/Dockerfile" "Dockerfile writes the system tmux config"
assert_grep "set -g mouse on" "$CASE_DIR/Dockerfile" "system tmux config turns the mouse on"
assert_eq "$(grep -n 'ARG GIT_USER_NAME' "$CASE_DIR/Dockerfile" | cut -d: -f1)" \
  "$(awk '/^ARG GIT_USER_NAME/{print NR}' "$CASE_DIR/Dockerfile")" "ARG pair is locatable"
install_line=$(awk '/claude.ai\/install.sh/{print NR; exit}' "$CASE_DIR/Dockerfile")
arg_line=$(awk '/^ARG GIT_USER_NAME/{print NR; exit}' "$CASE_DIR/Dockerfile")
if [ "$arg_line" -gt "$install_line" ]; then
  pass "git identity stays below the cached install layer"
else
  fail "git identity stays below the cached install layer" "ARG at $arg_line, install at $install_line"
fi

section "vm cache handling"
new_case; stub_all
mkdir -p "$WORK/.airlock"; : > "$WORK/.airlock/disk"
run_script
assert_exists "$WORK/.airlock/disk" "a plain run keeps the cached VM disk"

new_case; stub_all
mkdir -p "$WORK/.airlock"; : > "$WORK/.airlock/disk"
run_script -r
assert_absent "$WORK/.airlock" "-r drops the cached VM disk"

section "podman fallback"
new_case; stub_all_but_docker
export PROBE_DOCKER=1
run_script
assert_rc 0 "$RC" "podman-only host launches"
assert_grep "podman REACHED: probe-from-airlock" "$LOG" "shimmed docker forwards to podman"
shim=$(sed -n 's/^SHIM_PATH: //p' "$LOG")
case $shim in
  */airlock-claude.*/docker) pass "shim uses an explicit mktemp template" ;;
  *) fail "shim uses an explicit mktemp template" "shim path was [$shim]" ;;
esac
assert_absent "$(dirname "$shim")" "shim directory is removed on exit"

section "HOME placement"
new_case; stub_all
run_script
assert_eq "LAUNCH_HOME: $FAKE_HOME" "$(grep '^LAUNCH_HOME:' "$LOG")" "HOME untouched on a plain root"

new_case; stub_all
export DF_MODE=separate_filesystem
run_script
assert_eq "LAUNCH_HOME: /mnt/data" "$(grep '^LAUNCH_HOME:' "$LOG")" "HOME follows the working filesystem"

new_case; stub_all
export DF_MODE=bsd_rejects_output
run_script
assert_eq "LAUNCH_HOME: $FAKE_HOME" "$(grep '^LAUNCH_HOME:' "$LOG")" "BSD df leaves HOME alone"

new_case; stub_all
export DF_MODE=header_only
run_script
assert_eq "LAUNCH_HOME: $FAKE_HOME" "$(grep '^LAUNCH_HOME:' "$LOG")" "empty df answer leaves HOME alone"

printf '\n%s\n' "----------------------------------------"
printf '%d passed, %d failed\n' "$PASSED" "$FAILED"
[ "$FAILED" -eq 0 ] || exit 1
exit 0
