section "generated Dockerfile"
new_case; stub_all
export STUB_IMAGE_MISSING=1
run_script
assert_exists "$CASE_DIR/Dockerfile" "Dockerfile reaches the build on stdin"
assert_eq "FROM python:3.14-slim" "$(head -1 "$CASE_DIR/Dockerfile")" "Dockerfile starts at the base image"
assert_grep "claude.ai/install.sh" "$CASE_DIR/Dockerfile" "Dockerfile installs Claude Code"
assert_grep "usr/local/bin/claude" "$CASE_DIR/Dockerfile" "Dockerfile writes the updating wrapper"
assert_grep "unzip openssh-client" "$CASE_DIR/Dockerfile" "Dockerfile keeps the base package list"
assert_grep "^ *tmux locales ncurses-term vim \\\\$" "$CASE_DIR/Dockerfile" \
  "Dockerfile installs tmux, locales, ncurses-term and vim, and nothing else"
assert_grep "apt-get install -y --reinstall ncurses-base" "$CASE_DIR/Dockerfile" \
  "Dockerfile reinstalls ncurses-base to restore the entries ncurses-term hides"
assert_eq "ncurses-term
ncurses-base" "$(grep -o 'ncurses-term\|--reinstall ncurses-base' "$CASE_DIR/Dockerfile" | sed 's/--reinstall //')" \
  "the ncurses-base reinstall comes after ncurses-term"
assert_grep "^ENV LANG=en_US.UTF-8$" "$CASE_DIR/Dockerfile" "Dockerfile sets a UTF-8 locale"
assert_grep "en_US.UTF-8 UTF-8' > /etc/locale.gen" "$CASE_DIR/Dockerfile" "Dockerfile seeds locale.gen with that locale"
assert_grep "locale-gen" "$CASE_DIR/Dockerfile" "Dockerfile generates it"
assert_grep "etc/claude-code/managed-settings.json" "$CASE_DIR/Dockerfile" \
  "Dockerfile writes the system Claude Code settings"
assert_grep '"defaultMode": "bypassPermissions"' "$CASE_DIR/Dockerfile" \
  "system settings bypass permission prompts"
assert_grep '"skipDangerousModePermissionPrompt": true' "$CASE_DIR/Dockerfile" \
  "system settings pre-accept the bypass warning"
assert_grep "etc/claude-code/CLAUDE.md" "$CASE_DIR/Dockerfile" \
  "Dockerfile writes the system Claude Code memory"
assert_grep "denied by network policy" "$CASE_DIR/Dockerfile" \
  "system memory describes the 403 the proxy answers denied requests with"
assert_grep "remind them to revert the airlock" "$CASE_DIR/Dockerfile" \
  "system memory tells Claude Code it can ask for temporary network access"
assert_grep "VERIFY_X509_STRICT" "$CASE_DIR/Dockerfile" \
  "system memory tells Claude Code how to get Python past the TLS proxy"
assert_grep "delete or overwrite a virtualenv you did not create in this session" \
  "$CASE_DIR/Dockerfile" "system memory keeps Claude Code out of the host's virtualenvs"
assert_not_grep "^ *'[^']*'[^']*' \\\\$" "$CASE_DIR/Dockerfile" \
  "printf'd file content has no apostrophe to break its single quotes"
if awk '/^RUN /{blk=""; grab=1} grab{blk=blk $0 "\n"} grab && !/\\$/{grab=0; print blk "\n"}' \
     "$CASE_DIR/Dockerfile" | sed 's/^RUN //' | sh -n 2>/dev/null; then
  pass "every RUN command parses as shell"
else
  fail "every RUN command parses as shell"
fi
assert_grep "etc/tmux.conf" "$CASE_DIR/Dockerfile" "Dockerfile writes the system tmux config"
assert_grep "set -g mouse on" "$CASE_DIR/Dockerfile" "system tmux config turns the mouse on"
assert_eq "$(grep -n 'ARG GIT_USER_NAME' "$CASE_DIR/Dockerfile" | cut -d: -f1)" \
  "$(awk '/^ARG GIT_USER_NAME/{print NR}' "$CASE_DIR/Dockerfile")" "ARG pair is locatable"
install_line=$(awk '/claude.ai\/install.sh/{print NR; exit}' "$CASE_DIR/Dockerfile")
arg_line=$(awk '/^ARG GIT_USER_NAME/{print NR; exit}' "$CASE_DIR/Dockerfile")
if [ "$arg_line" -gt "$install_line" ]; then
  pass "git identity stays below the cached install layer"
else
  fail "git identity stays below the cached install layer" "ARG at $arg_line, install at $install_line"
fi

