#!/bin/sh
if [ "$1" = config ] && [ "$2" = --list ]; then
  printf 'user.name=Lower Precedence Name\n'
  printf 'user.email=lower-precedence@example.com\n'
  printf 'user.name=Higher Precedence Name\n'
  printf 'user.email=higher-precedence@example.com\n'
  exit 0
fi
exit 0
EOF
  chmod +x "$BIN/git"
}

stub_defaults() {
  cat > "$BIN/defaults" <<'EOF'
#!/bin/sh
case "${DEFAULTS_MODE:-dark}" in
  dark) echo Dark ;;
  light)
    echo "The domain/default pair of (kCFPreferencesAnyApplication, AppleInterfaceStyle) does not exist" >&2
    exit 1 ;;
esac
exit 0
EOF
  chmod +x "$BIN/defaults"
}

