#!/bin/bash

IMAGE=airlock-claude:latest

usage() {
  cat <<'USAGE'
Usage: airlock-claude [-M|--no-monitor] [-T|--no-tmux] [-c|--remote-control]
                      [--theme <theme>] [--mount-rw <dir>] [--mount-ro <dir>]
                      [-r|--rebuild-image] [-h|--help]
                      [-- <claude args...>]
       airlock-claude [-M|--no-monitor] [-T|--no-tmux] [--mount-rw <dir>]
                      [--mount-ro <dir>] [-r|--rebuild-image]
                      -x|--exec -- <command...>

Runs Claude Code sandboxed in an airlock VM in the current directory,
building the sandbox image and generating airlock config as needed.

The session runs inside tmux, under airlock's monitor TUI, by default.

When the session ends, the last lines of its output are printed again —
the monitor and tmux restore the host screen on exit, taking the session's
final words with them — and the whole terminal log of the run is kept in
.airlock/sandbox/pty.dump, with the previous run's log beside it as
pty.dump.previous.

  -M, --no-monitor     Run without the monitor TUI, handing the host terminal
                       straight to the session.
  -m, --monitor        Run under the monitor TUI (the default).
  -T, --no-tmux        Run claude directly instead of inside tmux. Also the
                       way out if the image predates tmux — rebuild with -r
                       to get it.
  -t, --tmux           Run inside tmux (the default).
  -c, --remote-control Run claude with --remote-control. Turns off the
                       preset's OAuth token injection and hides its
                       placeholder token from the session, so claude asks
                       for an interactive login instead — remote control
                       doesn't work on an injected token. The login is
                       saved under ~/.airlock/claude and reused next run.
  --theme <theme>      Tell claude which colour theme to use: dark, light,
                       auto, dark-daltonized, light-daltonized, dark-ansi or
                       light-ansi. The AIRLOCK_CLAUDE_THEME environment
                       variable sets the same thing; the flag wins. Without
                       either, the theme is picked on the host — the terminal
                       is asked for its background colour, then the macOS
                       appearance and COLORFGBG are consulted — because
                       claude's own detection can't reach the host terminal
                       from inside the VM. When nothing answers, claude keeps
                       whatever theme it already had.
  --mount-rw <dir>     Mount another host directory into the VM, read-write,
                       under the project directory as its basename — e.g.
                       --mount-rw ../other-project appears as ./other-project
                       in the session. Repeatable. Lets related projects sit
                       next to this one on the host instead of being copied
                       into it.
  --mount-ro <dir>     Like --mount-rw, but read-only: the session can read
                       and build against the directory but not change it.
  -x, --exec           Run the command given after -- instead of claude,
                       in the same VM and, by default, the same tmux and
                       monitor wrappers. The claude-only flags --theme and
                       -c/--remote-control cannot be combined with it.
  -r, --rebuild-image  Rebuild the sandbox image from scratch, ignoring the
                       layer cache and re-pulling the base image, and drop
                       the local .airlock directory so airlock converts the
                       refreshed image instead of its cached VM disk.
  -h, --help           Show this help.

Arguments after -- are passed to claude verbatim:

  airlock-claude -- --resume
  airlock-claude -M -- -p "run the tests"

With -x, the arguments after -- replace claude entirely:

  airlock-claude -x -- bash
  airlock-claude -M -T -x -- python3 -m http.server
USAGE
}

parse_args() {
  REBUILD= MONITOR=1 USE_TMUX=1 REMOTE_CONTROL= THEME= EXEC= SHOW_USAGE= CLAUDE_ARGS=()
  MOUNTS_RW=() MOUNTS_RO=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --) shift; CLAUDE_ARGS=("$@"); return 0 ;;
      -m|--monitor) MONITOR=1 ;;
      -M|--no-monitor) MONITOR= ;;
      -t|--tmux) USE_TMUX=1 ;;
      -T|--no-tmux) USE_TMUX= ;;
      -c|--remote-control) REMOTE_CONTROL=1 ;;
      --theme)
        if [[ $# -lt 2 ]]; then
          echo "airlock-claude: --theme needs a value" >&2
          return 2
        fi
        THEME=$2
        shift ;;
      --theme=*) THEME=${1#--theme=} ;;
      --mount-rw|--mount-ro)
        if [[ $# -lt 2 ]]; then
          echo "airlock-claude: $1 needs a directory" >&2
          return 2
        fi
        if [[ $1 == --mount-rw ]]; then MOUNTS_RW+=("$2"); else MOUNTS_RO+=("$2"); fi
        shift ;;
      --mount-rw=*) MOUNTS_RW+=("${1#--mount-rw=}") ;;
      --mount-ro=*) MOUNTS_RO+=("${1#--mount-ro=}") ;;
      -x|--exec) EXEC=1 ;;
      -r|--rebuild-image) REBUILD=1 ;;
      -h|--help) SHOW_USAGE=1; break ;;
      *)
        echo "airlock-claude: unknown option: $1" >&2
        echo "Try 'airlock-claude --help'." >&2
        return 2 ;;
    esac
    shift
  done
}

validate_exec_usage() {
  local exec_given=$1 remote_control=$2 flag_theme=$3 command_word_count=$4
  [[ -n $exec_given ]] || return 0
  if (( command_word_count == 0 )); then
    echo "airlock-claude: --exec needs a command after --" >&2
    return 2
  fi
  local conflict=
  [[ -n $remote_control ]] && conflict=--remote-control
  [[ -n $flag_theme ]] && conflict=--theme
  if [[ -n $conflict ]]; then
    echo "airlock-claude: $conflict configures claude, which --exec replaces" >&2
    return 2
  fi
}

require_airlock() {
  if ! command -v airlock >/dev/null 2>&1; then
    echo "airlock not found in PATH" >&2
    return 1
  fi
}

validate_theme() {
  local theme=$1
  case $theme in
    dark|light|auto|dark-daltonized|light-daltonized|dark-ansi|light-ansi)
      return 0 ;;
    *)
      echo "airlock-claude: unknown theme: $theme" >&2
      echo "Themes: dark light auto dark-daltonized light-daltonized dark-ansi light-ansi" >&2
      return 2 ;;
  esac
}

channel_as_8_bit() {
  local hex=${1%%[!0-9a-fA-F]*}
  if [[ -z $hex || ${#hex} -gt 4 ]]; then
    return 1
  fi
  if [[ ${#hex} -eq 1 ]]; then
    hex=$hex$hex
  fi
  printf '%d\n' "$((16#${hex:0:2}))"
}

theme_from_terminal_background() {
  [[ -t 0 && -t 2 ]] || return 1
  local saved_tty_state reply= channels r g b
  saved_tty_state=$(stty -g </dev/tty 2>/dev/null) || return 1
  stty -icanon -echo min 0 time 0 </dev/tty 2>/dev/null || return 1
  printf '\033]11;?\033\\' >/dev/tty
  IFS= read -rs -t 1 -d '\' reply </dev/tty
  stty "$saved_tty_state" </dev/tty 2>/dev/null
  case $reply in
    *rgba:*) channels=${reply#*rgba:} ;;
    *rgb:*) channels=${reply#*rgb:} ;;
    *) return 1 ;;
  esac
  IFS=/ read -r r g b _ <<<"$channels"
  r=$(channel_as_8_bit "$r") && g=$(channel_as_8_bit "$g") \
    && b=$(channel_as_8_bit "$b") || return 1
  if (( 2126 * r + 7152 * g + 722 * b >= 1280000 )); then
    printf 'light\n'
  else
    printf 'dark\n'
  fi
}

theme_from_macos_appearance() {
  command -v defaults >/dev/null 2>&1 || return 1
  local style
  style=$(defaults read -g AppleInterfaceStyle 2>&1)
  case $style in
    Dark) printf 'dark\n' ;;
    *"does not exist"*) printf 'light\n' ;;
    *) return 1 ;;
  esac
}

theme_from_colorfgbg() {
  local colorfgbg=$1
  local background=${colorfgbg##*;}
  if [[ $background == "$colorfgbg" || -z $background || $background == *[!0-9]* ]]; then
    return 1
  fi
  if (( background == 7 || background >= 9 )); then
    printf 'light\n'
  else
    printf 'dark\n'
  fi
}

resolve_theme() {
  local flag_theme=$1 env_theme=$2 colorfgbg=$3
  local requested=${flag_theme:-$env_theme}
  if [[ -n $requested ]]; then
    validate_theme "$requested" || return 2
    printf '%s\n' "$requested"
    return 0
  fi
  theme_from_terminal_background && return 0
  theme_from_macos_appearance && return 0
  theme_from_colorfgbg "$colorfgbg" && return 0
  return 0
}

resolve_extra_mount() {
  local flag=$1 dir=$2 read_only=$3
  local source target existing
  if [[ -z $dir ]]; then
    echo "airlock-claude: $flag needs a directory" >&2
    return 2
  fi
  if [[ ! -d $dir ]]; then
    echo "airlock-claude: $flag: not a directory: $dir" >&2
    return 2
  fi
  source=$(CDPATH= cd -- "$dir" 2>/dev/null && pwd) || {
    echo "airlock-claude: $flag: cannot resolve: $dir" >&2
    return 2
  }
  if [[ $source == "$PWD" ]]; then
    echo "airlock-claude: $flag: $dir is the project directory, which is always mounted" >&2
    return 2
  fi
  target=${source##*/}
  if [[ -z $target ]]; then
    echo "airlock-claude: $flag: cannot mount the filesystem root" >&2
    return 2
  fi
  for existing in ${MOUNT_TARGETS[@]+"${MOUNT_TARGETS[@]}"}; do
    if [[ $existing == "$target" ]]; then
      echo "airlock-claude: two mounts would both appear as ./$target; rename one on the host" >&2
      return 2
    fi
  done
  MOUNT_SOURCES+=("$source")
  MOUNT_TARGETS+=("$target")
  MOUNT_READ_ONLY+=("$read_only")
}

resolve_extra_mounts() {
  MOUNT_SOURCES=() MOUNT_TARGETS=() MOUNT_READ_ONLY=()
  local dir
  for dir in ${MOUNTS_RW[@]+"${MOUNTS_RW[@]}"}; do
    resolve_extra_mount --mount-rw "$dir" false || return $?
  done
  for dir in ${MOUNTS_RO[@]+"${MOUNTS_RO[@]}"}; do
    resolve_extra_mount --mount-ro "$dir" true || return $?
  done
}

toml_escaped() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s\n' "$s"
}

extra_mounts_toml() {
  local i source target
  for ((i = 0; i < ${#MOUNT_SOURCES[@]}; i++)); do
    source=$(toml_escaped "${MOUNT_SOURCES[i]}")
    target=$(toml_escaped "${MOUNT_TARGETS[i]}")
    printf '\n[mounts."%s"]\nsource = "%s"\ntarget = "%s"\nread_only = %s\n' \
      "$target" "$source" "$target" "${MOUNT_READ_ONLY[i]}"
  done
}

pick_container_engine() {
  if command -v docker >/dev/null 2>&1; then
    printf '%s\n' docker
  elif command -v podman >/dev/null 2>&1; then
    printf '%s\n' podman
  else
    echo "Neither docker nor podman found in PATH" >&2
    return 1
  fi
}

create_docker_shim() {
  local shim_dir
  shim_dir=$(mktemp -d "${TMPDIR:-/tmp}/airlock-claude.XXXXXX") || return 1
  printf '#!/bin/sh\nexec podman "$@"\n' > "$shim_dir/docker" \
    && chmod +x "$shim_dir/docker" \
    || { rm -rf "$shim_dir"; return 1; }
  printf '%s\n' "$shim_dir"
}

build_image_if_needed() {
  local engine=$1 rebuild=$2
  if [[ -z $rebuild ]] && "$engine" image inspect "$IMAGE" >/dev/null 2>&1; then
    return 0
  fi

  echo "Building $IMAGE with $engine ..." >&2
  local build_flags=()
  [[ -n $rebuild ]] && build_flags=(--no-cache --pull)
  local config_in_precedence_order git_user_name git_user_email
  config_in_precedence_order=$(git config --list --includes 2>/dev/null)
  git_user_name=$(printf '%s\n' "$config_in_precedence_order" | sed -n 's/^user\.name=//p' | tail -1)
  git_user_email=$(printf '%s\n' "$config_in_precedence_order" | sed -n 's/^user\.email=//p' | tail -1)
  "$engine" build -t "$IMAGE" "${build_flags[@]}" \
    --build-arg "GIT_USER_NAME=$git_user_name" \
    --build-arg "GIT_USER_EMAIL=$git_user_email" - <<'DOCKERFILE' || return 1
FROM python:3.14-slim
RUN DEBIAN_FRONTEND=noninteractive apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates git curl ripgrep jq less procps unzip openssh-client \
      tmux locales ncurses-term vim \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --reinstall ncurses-base \
 && echo 'en_US.UTF-8 UTF-8' > /etc/locale.gen \
 && locale-gen \
 && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8

ENV CLAUDE_INSTALL_HOME=/opt/claude
ENV PATH="$PATH:/opt/claude/.local/bin"
RUN mkdir -p "$CLAUDE_INSTALL_HOME" \
 && HOME="$CLAUDE_INSTALL_HOME" sh -c 'curl -fsSL https://claude.ai/install.sh | bash' \
 && chmod -R a+rwX "$CLAUDE_INSTALL_HOME"

RUN printf '%s\n' \
      '#!/bin/sh' \
      'LAUNCHER="${CLAUDE_INSTALL_HOME:-/opt/claude}/.local/bin/claude"' \
      'UPDATED_THIS_BOOT=/tmp/.airlock-claude-updated-this-boot' \
      'if [ -z "$AIRLOCK_CLAUDE_SKIP_UPDATE" ] && [ ! -e "$UPDATED_THIS_BOOT" ]; then' \
      '  : > "$UPDATED_THIS_BOOT" 2>/dev/null' \
      '  HOME="${CLAUDE_INSTALL_HOME:-/opt/claude}" "$LAUNCHER" update >&2 ||' \
      '    echo "airlock-claude: update failed, using the version from the image" >&2' \
      'fi' \
      'exec "$LAUNCHER" "$@"' \
      > /usr/local/bin/claude \
 && chmod +x /usr/local/bin/claude

RUN mkdir -p /etc/claude-code \
 && printf '%s\n' \
      '{' \
      '  "permissions": { "defaultMode": "bypassPermissions" },' \
      '  "skipDangerousModePermissionPrompt": true' \
      '}' \
      > /etc/claude-code/managed-settings.json

RUN printf '%s\n' \
      '# Sandbox notes (airlock-claude)' \
      '' \
      'This session runs inside an airlock VM. Outbound network access is denied' \
      'except for allowlisted hosts, and the HTTPS traffic that is allowed goes' \
      'through the airlock TLS proxy, which re-signs every host with its own' \
      '"airlock CA". The system trust store already includes that CA, so curl,' \
      'git, pip and Node work unchanged.' \
      '' \
      'An HTTP request the policy denies is answered by the proxy itself with' \
      '403 Forbidden and the body "denied by network policy" (one line). That' \
      'response means the airlock policy blocked the request, not that the' \
      'remote server refused it.' \
      '' \
      '## Blocked traffic can be allowed interactively' \
      '' \
      'The user can usually enable traffic that does not match the allow/deny' \
      'rules of the airlock policy, temporarily and interactively, from outside' \
      'the session. If network access beyond the allowlist would be important' \
      'for the task, ask the user to allow the traffic instead of working' \
      'around the block. When they do, remind them to revert the airlock' \
      'network policy once the part of the work that needed the extra access' \
      'is done.' \
      '' \
      '## Python HTTPS fails with "Missing Authority Key Identifier"' \
      '' \
      'Every Python HTTPS client fails certificate verification here: urllib,' \
      'http.client, urllib3, requests, httpx and aiohttp all raise' \
      'CERTIFICATE_VERIFY_FAILED with "Missing Authority Key Identifier" (requests' \
      'and httpx may say "unable to get local issuer certificate" first). Python' \
      '3.13+ turns on VERIFY_X509_STRICT by default, and the per-host certificates' \
      'the proxy issues carry no Authority Key Identifier extension, so strict' \
      'checking rejects them. SSL_CERT_FILE and REQUESTS_CA_BUNDLE do not help.' \
      '' \
      'Fix: build one SSL context with strict checking off and pass it explicitly.' \
      'Verification itself stays on; do not use verify=False or CERT_NONE.' \
      '' \
      '    import ssl' \
      '    ctx = ssl.create_default_context()' \
      '    ctx.verify_flags &= ~ssl.VERIFY_X509_STRICT' \
      '' \
      '    urllib.request.urlopen(url, context=ctx)' \
      '    http.client.HTTPSConnection(host, context=ctx)' \
      '    urllib3.PoolManager(ssl_context=ctx)' \
      '    httpx.get(url, verify=ctx)            # or httpx.Client(verify=ctx)' \
      '    session.get(url, ssl=ctx)             # aiohttp' \
      '' \
      '    class Adapter(requests.adapters.HTTPAdapter):    # requests' \
      '        def init_poolmanager(self, *args, **kwargs):' \
      '            kwargs["ssl_context"] = ctx' \
      '            return super().init_poolmanager(*args, **kwargs)' \
      '    s = requests.Session(); s.mount("https://", Adapter())' \
      '' \
      'For a one-off download, curl works without any of this.' \
      '' \
      '## Virtualenvs you find here belong to the host' \
      '' \
      'The working directory is shared with the host, so any .venv, venv or other' \
      'virtualenv already in it was almost certainly created on the host, with a' \
      'different Python at a different path. Its interpreter symlinks, pyvenv.cfg' \
      'and compiled wheels will not match this sandbox. Never activate, reuse,' \
      'delete or overwrite a virtualenv you did not create in this session. Make' \
      'your own under a different name, for example python3 -m venv .venv-airlock,' \
      'and leave the existing one alone.' \
      > /etc/claude-code/CLAUDE.md

RUN printf '%s\n' \
      'set -g mouse on' \
      'set -g set-clipboard on' \
      'set -as terminal-features ",*:clipboard"' \
      'set -g default-terminal "tmux-256color"' \
      > /etc/tmux.conf

RUN printf '%s\n' \
      '' \
      '# airlock-claude: ls conveniences for interactive shells' \
      'alias ls="ls --color=auto"' \
      'alias l="ls -CF"' \
      'alias la="ls -A"' \
      'alias ll="ls -lh"' \
      'alias lll="ls -lhA"' \
      >> /etc/bash.bashrc

ARG GIT_USER_NAME=
ARG GIT_USER_EMAIL=
RUN if [ -n "$GIT_USER_NAME" ]; then git config --system user.name "$GIT_USER_NAME"; fi \
 && if [ -n "$GIT_USER_EMAIL" ]; then git config --system user.email "$GIT_USER_EMAIL"; fi
DOCKERFILE
}

drop_vm_cache_on_rebuild() {
  local rebuild=$1
  if [[ -n $rebuild ]]; then
    rm -rf .airlock
  fi
}

generate_airlock_config() {
  local skip_update=$1 remote_control=$2 extra_mounts=$3
  local skip_update_line=
  if [[ -n $skip_update ]]; then
    skip_update_line='AIRLOCK_CLAUDE_SKIP_UPDATE = "1"'
  fi
  local token_middleware_override=
  if [[ -n $remote_control ]]; then
    token_middleware_override='[network.middleware.claude-auth-token]
enabled = false'
  fi

  if ! cat > airlock.local.toml <<EOF
presets = ["claude-code", "debian", "python"]

[network]
policy = "deny-by-default"

[vm.image]
name = "$IMAGE"
resolution = "docker"

[env]
DISABLE_AUTOUPDATER = "1"
$skip_update_line
$token_middleware_override
$extra_mounts
EOF
  then
    echo "airlock-claude: could not write airlock.local.toml in $PWD" >&2
    return 1
  fi
}

home_on_working_filesystem() {
  local current_home=$1
  local df_bin fs_root
  df_bin=$(command -v gdf || command -v df) || {
    echo "Neither gdf nor df found in PATH" >&2
    return 1
  }
  fs_root=$("$df_bin" --output=target . 2>/dev/null | tail -1)
  if [[ $fs_root == /* && $fs_root != "/" && $fs_root != "/home" ]]; then
    printf '%s\n' "$fs_root"
  else
    printf '%s\n' "$current_home"
  fi
}

keep_previous_pty_dump() {
  local dump=$1
  if [[ -s $dump ]]; then
    mv -f "$dump" "$dump.previous"
  fi
}

strip_terminal_escapes() {
  local esc=$'\033' bel=$'\007'
  LC_ALL=C tr -d '\000' \
    | LC_ALL=C tr '\r' '\n' \
    | LC_ALL=C sed -E \
        -e "s/${esc}\][^${bel}${esc}]*(${bel}|${esc}\\\\)?//g" \
        -e "s/${esc}[PX^_][^${esc}]*(${esc}\\\\)?//g" \
        -e "s/${esc}\[[^@-~]*[@-~]//g" \
        -e "s/${esc}[()][0-9A-Za-z]//g" \
        -e "s/${esc}.//g" \
    | LC_ALL=C tr -d '\001-\010\013\014\016-\037\177'
}

print_pty_dump_tail() {
  local dump=$1 max_lines=$2
  [[ -s $dump ]] || return 0
  local last_lines
  last_lines=$(tail -c 65536 "$dump" | strip_terminal_escapes \
    | LC_ALL=C sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -n "$max_lines")
  [[ -n $last_lines ]] || return 0
  printf 'airlock-claude: last session output (whole log: %s):\n' "$dump"
  printf '%s\n' "$last_lines" | sed 's/^/  /'
}

parse_args "$@" || exit $?
[[ -n $SHOW_USAGE ]] && { usage; exit 0; }

validate_exec_usage "$EXEC" "$REMOTE_CONTROL" "$THEME" "${#CLAUDE_ARGS[@]}" || exit $?

require_airlock || exit 1

if [[ -z $EXEC ]]; then
  THEME=$(resolve_theme "$THEME" "${AIRLOCK_CLAUDE_THEME:-}" "${COLORFGBG:-}") || exit 2
fi

resolve_extra_mounts || exit $?

CONTAINER_ENGINE=$(pick_container_engine) || exit 1
if [[ $CONTAINER_ENGINE == podman ]]; then
  SHIM_DIR=$(create_docker_shim) || exit 1
  trap 'rm -rf "$SHIM_DIR"' EXIT
  export PATH="$SHIM_DIR:$PATH"
fi

build_image_if_needed "$CONTAINER_ENGINE" "$REBUILD" || exit 1
drop_vm_cache_on_rebuild "$REBUILD"
generate_airlock_config "${AIRLOCK_CLAUDE_SKIP_UPDATE:-}" "$REMOTE_CONTROL" "$(extra_mounts_toml)" || exit 1

HOME=$(home_on_working_filesystem "$HOME") || exit 1
export HOME

keep_previous_pty_dump .airlock/sandbox/pty.dump

if [[ -n $EXEC ]]; then
  SESSION_COMMAND=("${CLAUDE_ARGS[@]}")
else
  SESSION_COMMAND=(${REMOTE_CONTROL:+env -u CLAUDE_CODE_OAUTH_TOKEN} claude)
  [[ -n $THEME ]] && SESSION_COMMAND+=(--settings "{\"theme\":\"$THEME\"}")
  [[ -n $REMOTE_CONTROL ]] && SESSION_COMMAND+=(--remote-control)
  SESSION_COMMAND+=("${CLAUDE_ARGS[@]}")
fi

AIRLOCK_PTY_DUMP=1 airlock start ${MONITOR:+--monitor} -- ${USE_TMUX:+tmux -u new-session -A -s claude} "${SESSION_COMMAND[@]}"
AIRLOCK_EXIT=$?

print_pty_dump_tail .airlock/sandbox/pty.dump 15 >&2
exit "$AIRLOCK_EXIT"
