#!/bin/bash

IMAGE=airlock-claude:latest

usage() {
  cat <<'USAGE'
Usage: airlock-claude [-M|--no-monitor] [-T|--no-tmux] [-c|--remote-control]
                      [-r|--rebuild-image] [-h|--help] [-- <claude args...>]

Runs Claude Code sandboxed in an airlock VM in the current directory,
building the sandbox image and generating airlock config as needed.

The session runs inside tmux, under airlock's monitor TUI, by default.

  -M, --no-monitor     Run without the monitor TUI, handing the host terminal
                       straight to the session.
  -m, --monitor        Run under the monitor TUI (the default).
  -T, --no-tmux        Run claude directly instead of inside tmux. Also the
                       way out if the image predates tmux — rebuild with -r
                       to get it.
  -t, --tmux           Run inside tmux (the default).
  -c, --remote-control Run claude with --remote-control. Turns off the
                       preset's OAuth token injection and hides its
                       placeholder token from the session, so claude asks
                       for an interactive login instead — remote control
                       doesn't work on an injected token. The login is
                       saved under ~/.airlock/claude and reused next run.
  -r, --rebuild-image  Rebuild the sandbox image from scratch, ignoring the
                       layer cache and re-pulling the base image, and drop
                       the local .airlock directory so airlock converts the
                       refreshed image instead of its cached VM disk.
  -h, --help           Show this help.

Arguments after -- are passed to claude verbatim:

  airlock-claude -- --resume
  airlock-claude -M -- -p "run the tests"
USAGE
}

parse_args() {
  REBUILD= MONITOR=1 USE_TMUX=1 REMOTE_CONTROL= SHOW_USAGE= CLAUDE_ARGS=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --) shift; CLAUDE_ARGS=("$@"); return 0 ;;
      -m|--monitor) MONITOR=1 ;;
      -M|--no-monitor) MONITOR= ;;
      -t|--tmux) USE_TMUX=1 ;;
      -T|--no-tmux) USE_TMUX= ;;
      -c|--remote-control) REMOTE_CONTROL=1 ;;
      -r|--rebuild-image) REBUILD=1 ;;
      -h|--help) SHOW_USAGE=1; break ;;
      *)
        echo "airlock-claude: unknown option: $1" >&2
        echo "Try 'airlock-claude --help'." >&2
        return 2 ;;
    esac
    shift
  done
}

require_airlock() {
  if ! command -v airlock >/dev/null 2>&1; then
    echo "airlock not found in PATH" >&2
    return 1
  fi
}

pick_container_engine() {
  if command -v docker >/dev/null 2>&1; then
    printf '%s\n' docker
  elif command -v podman >/dev/null 2>&1; then
    printf '%s\n' podman
  else
    echo "Neither docker nor podman found in PATH" >&2
    return 1
  fi
}

create_docker_shim() {
  local shim_dir
  shim_dir=$(mktemp -d "${TMPDIR:-/tmp}/airlock-claude.XXXXXX") || return 1
  printf '#!/bin/sh\nexec podman "$@"\n' > "$shim_dir/docker" \
    && chmod +x "$shim_dir/docker" \
    || { rm -rf "$shim_dir"; return 1; }
  printf '%s\n' "$shim_dir"
}

build_image_if_needed() {
  local engine=$1 rebuild=$2
  if [[ -z $rebuild ]] && "$engine" image inspect "$IMAGE" >/dev/null 2>&1; then
    return 0
  fi

  echo "Building $IMAGE with $engine ..." >&2
  local build_flags=()
  [[ -n $rebuild ]] && build_flags=(--no-cache --pull)
  local config_in_precedence_order git_user_name git_user_email
  config_in_precedence_order=$(git config --list --includes 2>/dev/null)
  git_user_name=$(printf '%s\n' "$config_in_precedence_order" | sed -n 's/^user\.name=//p' | tail -1)
  git_user_email=$(printf '%s\n' "$config_in_precedence_order" | sed -n 's/^user\.email=//p' | tail -1)
  "$engine" build -t "$IMAGE" "${build_flags[@]}" \
    --build-arg "GIT_USER_NAME=$git_user_name" \
    --build-arg "GIT_USER_EMAIL=$git_user_email" - <<'DOCKERFILE' || return 1
FROM python:3.14-slim
RUN DEBIAN_FRONTEND=noninteractive apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates git curl ripgrep jq less procps unzip openssh-client \
      tmux locales ncurses-term vim \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --reinstall ncurses-base \
 && echo 'en_US.UTF-8 UTF-8' > /etc/locale.gen \
 && locale-gen \
 && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8

ENV CLAUDE_INSTALL_HOME=/opt/claude
ENV PATH="$PATH:/opt/claude/.local/bin"
RUN mkdir -p "$CLAUDE_INSTALL_HOME" \
 && HOME="$CLAUDE_INSTALL_HOME" sh -c 'curl -fsSL https://claude.ai/install.sh | bash' \
 && chmod -R a+rwX "$CLAUDE_INSTALL_HOME"

RUN printf '%s\n' \
      '#!/bin/sh' \
      'LAUNCHER="${CLAUDE_INSTALL_HOME:-/opt/claude}/.local/bin/claude"' \
      'UPDATED_THIS_BOOT=/tmp/.airlock-claude-updated-this-boot' \
      'if [ -z "$AIRLOCK_CLAUDE_SKIP_UPDATE" ] && [ ! -e "$UPDATED_THIS_BOOT" ]; then' \
      '  : > "$UPDATED_THIS_BOOT" 2>/dev/null' \
      '  HOME="${CLAUDE_INSTALL_HOME:-/opt/claude}" "$LAUNCHER" update >&2 ||' \
      '    echo "airlock-claude: update failed, using the version from the image" >&2' \
      'fi' \
      'exec "$LAUNCHER" "$@"' \
      > /usr/local/bin/claude \
 && chmod +x /usr/local/bin/claude

RUN mkdir -p /etc/claude-code \
 && printf '%s\n' \
      '{' \
      '  "permissions": { "defaultMode": "bypassPermissions" },' \
      '  "skipDangerousModePermissionPrompt": true' \
      '}' \
      > /etc/claude-code/managed-settings.json

RUN printf '%s\n' \
      '# Sandbox notes (airlock-claude)' \
      '' \
      'This session runs inside an airlock VM. Outbound network access is denied' \
      'except for allowlisted hosts, and the HTTPS traffic that is allowed goes' \
      'through the airlock TLS proxy, which re-signs every host with its own' \
      '"airlock CA". The system trust store already includes that CA, so curl,' \
      'git, pip and Node work unchanged.' \
      '' \
      'An HTTP request the policy denies is answered by the proxy itself with' \
      '403 Forbidden and the body "denied by network policy" (one line). That' \
      'response means the airlock policy blocked the request, not that the' \
      'remote server refused it.' \
      '' \
      '## Blocked traffic can be allowed interactively' \
      '' \
      'The user can usually enable traffic that does not match the allow/deny' \
      'rules of the airlock policy, temporarily and interactively, from outside' \
      'the session. If network access beyond the allowlist would be important' \
      'for the task, ask the user to allow the traffic instead of working' \
      'around the block. When they do, remind them to revert the airlock' \
      'network policy once the part of the work that needed the extra access' \
      'is done.' \
      '' \
      '## Python HTTPS fails with "Missing Authority Key Identifier"' \
      '' \
      'Every Python HTTPS client fails certificate verification here: urllib,' \
      'http.client, urllib3, requests, httpx and aiohttp all raise' \
      'CERTIFICATE_VERIFY_FAILED with "Missing Authority Key Identifier" (requests' \
      'and httpx may say "unable to get local issuer certificate" first). Python' \
      '3.13+ turns on VERIFY_X509_STRICT by default, and the per-host certificates' \
      'the proxy issues carry no Authority Key Identifier extension, so strict' \
      'checking rejects them. SSL_CERT_FILE and REQUESTS_CA_BUNDLE do not help.' \
      '' \
      'Fix: build one SSL context with strict checking off and pass it explicitly.' \
      'Verification itself stays on; do not use verify=False or CERT_NONE.' \
      '' \
      '    import ssl' \
      '    ctx = ssl.create_default_context()' \
      '    ctx.verify_flags &= ~ssl.VERIFY_X509_STRICT' \
      '' \
      '    urllib.request.urlopen(url, context=ctx)' \
      '    http.client.HTTPSConnection(host, context=ctx)' \
      '    urllib3.PoolManager(ssl_context=ctx)' \
      '    httpx.get(url, verify=ctx)            # or httpx.Client(verify=ctx)' \
      '    session.get(url, ssl=ctx)             # aiohttp' \
      '' \
      '    class Adapter(requests.adapters.HTTPAdapter):    # requests' \
      '        def init_poolmanager(self, *args, **kwargs):' \
      '            kwargs["ssl_context"] = ctx' \
      '            return super().init_poolmanager(*args, **kwargs)' \
      '    s = requests.Session(); s.mount("https://", Adapter())' \
      '' \
      'For a one-off download, curl works without any of this.' \
      '' \
      '## Virtualenvs you find here belong to the host' \
      '' \
      'The working directory is shared with the host, so any .venv, venv or other' \
      'virtualenv already in it was almost certainly created on the host, with a' \
      'different Python at a different path. Its interpreter symlinks, pyvenv.cfg' \
      'and compiled wheels will not match this sandbox. Never activate, reuse,' \
      'delete or overwrite a virtualenv you did not create in this session. Make' \
      'your own under a different name, for example python3 -m venv .venv-airlock,' \
      'and leave the existing one alone.' \
      > /etc/claude-code/CLAUDE.md

RUN printf '%s\n' \
      'set -g mouse on' \
      'set -g set-clipboard on' \
      'set -as terminal-features ",*:clipboard"' \
      'set -g default-terminal "tmux-256color"' \
      > /etc/tmux.conf

RUN printf '%s\n' \
      '' \
      '# airlock-claude: ls conveniences for interactive shells' \
      'alias ls="ls --color=auto"' \
      'alias l="ls -CF"' \
      'alias la="ls -A"' \
      'alias ll="ls -lh"' \
      'alias lll="ls -lhA"' \
      >> /etc/bash.bashrc

ARG GIT_USER_NAME=
ARG GIT_USER_EMAIL=
RUN if [ -n "$GIT_USER_NAME" ]; then git config --system user.name "$GIT_USER_NAME"; fi \
 && if [ -n "$GIT_USER_EMAIL" ]; then git config --system user.email "$GIT_USER_EMAIL"; fi
DOCKERFILE
}

drop_vm_cache_on_rebuild() {
  local rebuild=$1
  if [[ -n $rebuild ]]; then
    rm -rf .airlock
  fi
}

generate_airlock_config() {
  local skip_update=$1 remote_control=$2
  local skip_update_line=
  if [[ -n $skip_update ]]; then
    skip_update_line='AIRLOCK_CLAUDE_SKIP_UPDATE = "1"'
  fi
  local token_middleware_override=
  if [[ -n $remote_control ]]; then
    token_middleware_override='[network.middleware.claude-auth-token]
enabled = false'
  fi

  if ! cat > airlock.local.toml <<EOF
presets = ["claude-code", "debian", "python"]

[network]
policy = "deny-by-default"

[vm.image]
name = "$IMAGE"
resolution = "docker"

[env]
DISABLE_AUTOUPDATER = "1"
$skip_update_line
$token_middleware_override
EOF
  then
    echo "airlock-claude: could not write airlock.local.toml in $PWD" >&2
    return 1
  fi
}

home_on_working_filesystem() {
  local current_home=$1
  local df_bin fs_root
  df_bin=$(command -v gdf || command -v df) || {
    echo "Neither gdf nor df found in PATH" >&2
    return 1
  }
  fs_root=$("$df_bin" --output=target . 2>/dev/null | tail -1)
  if [[ $fs_root == /* && $fs_root != "/" && $fs_root != "/home" ]]; then
    printf '%s\n' "$fs_root"
  else
    printf '%s\n' "$current_home"
  fi
}

parse_args "$@" || exit $?
[[ -n $SHOW_USAGE ]] && { usage; exit 0; }

require_airlock || exit 1

CONTAINER_ENGINE=$(pick_container_engine) || exit 1
if [[ $CONTAINER_ENGINE == podman ]]; then
  SHIM_DIR=$(create_docker_shim) || exit 1
  trap 'rm -rf "$SHIM_DIR"' EXIT
  export PATH="$SHIM_DIR:$PATH"
fi

build_image_if_needed "$CONTAINER_ENGINE" "$REBUILD" || exit 1
drop_vm_cache_on_rebuild "$REBUILD"
generate_airlock_config "${AIRLOCK_CLAUDE_SKIP_UPDATE:-}" "$REMOTE_CONTROL" || exit 1

HOME=$(home_on_working_filesystem "$HOME") || exit 1
export HOME

airlock start ${MONITOR:+--monitor} -- ${USE_TMUX:+tmux -u new-session -A -s claude} ${REMOTE_CONTROL:+env -u CLAUDE_CODE_OAUTH_TOKEN} claude ${REMOTE_CONTROL:+--remote-control} "${CLAUDE_ARGS[@]}"
