#!/bin/bash

usage() {
  cat <<'USAGE'
Usage: airlock-claude [-M|--no-monitor] [-T|--no-tmux] [-r|--rebuild]
                      [-c|--remote-control] [--mount-rw <dir>] [--mount-ro <dir>]
                      [-h|--help] [-- <claude args...>]
       airlock-claude [-M|--no-monitor] [-T|--no-tmux] [-r|--rebuild]
                      [-c|--remote-control] [--mount-rw <dir>] [--mount-ro <dir>]
                      -x|--exec -- <command...>

Runs Claude Code sandboxed in an airlock VM in the current directory, with
network access denied by default. On a project's first run airlock's
setup wizard asks which packs or template to use: pick alpine, claude and
airlock-claude (local), or a template built on them.

The airlock-claude pack installs tmux into the sandbox and writes the tmux
config, Claude Code's managed settings (bypass permissions) and managed
CLAUDE.md under /etc. Run from its repository checkout, this script copies
the pack to ~/.airlock/packs/airlock-claude, updating it when it changes;
run from anywhere else, it needs that copy to be there already.

The session runs inside tmux, under airlock's monitor TUI, by default.

When the session ends, the last lines of its output are printed again —
the monitor and tmux restore the host screen on exit, taking the session's
final words with them — and the whole terminal log of the run is kept as
pty.dump in the sandbox directory (`airlock info` shows it), with the
previous run's log beside it as pty.dump.previous.

  -M, --no-monitor  Run without the monitor TUI, handing the host terminal
                    straight to the session.
  -T, --no-tmux     Run claude directly instead of inside tmux.
  --mount-rw <dir>  Mount another host directory into the VM, read-write,
                    under the project directory as its basename: e.g.
                    --mount-rw ../other-project appears as ./other-project
                    in the session. Repeatable. The mounts are kept in a
                    marked block of airlock.local.toml, rewritten on every
                    run, and need a sandbox to exist already (run once
                    without mounts first, so the setup wizard can run).
  -c, --remote-control
                    Make Claude Code's /remote-control work: turn off
                    airlock's anthropic network service, whose credential
                    check refuses the Remote Control connection, and give
                    this sandbox a Claude Code directory of its own, kept in
                    the sandbox directory, instead of the one the claude
                    pack shares between sandboxes. /login in this mode puts
                    the real tokens into that directory and this sandbox
                    only. Needs a sandbox to exist already; written to the
                    same marked block of airlock.local.toml as the mounts.
  --mount-ro <dir>  Like --mount-rw, but read-only.
  -x, --exec        Run the command given after -- instead of claude, in
                    the same VM and, by default, the same tmux and monitor
                    wrappers.
  -r, --rebuild     Remove the project's sandbox (`airlock remove`) before
                    starting, so airlock makes a fresh one and the setup
                    wizard runs again. Anything installed inside the VM is
                    lost; the persisted Claude settings and login are not,
                    except the sandbox's own -c login, which goes with it.
  -h, --help        Show this help.

Arguments after -- are passed to claude verbatim:

  airlock-claude -- --resume
  airlock-claude -M -- -p "run the tests"

With -x, the arguments after -- replace claude entirely:

  airlock-claude -x -- bash
  airlock-claude -M -T -x -- python3 -m http.server
USAGE
}

parse_args() {
  MONITOR=1 USE_TMUX=1 EXEC= REBUILD= REMOTE_CONTROL= SHOW_USAGE= CLAUDE_ARGS=() MOUNTS_RW=() MOUNTS_RO=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --) shift; CLAUDE_ARGS=("$@"); return 0 ;;
      -M|--no-monitor) MONITOR= ;;
      -T|--no-tmux) USE_TMUX= ;;
      --mount-rw|--mount-ro)
        if [[ $# -lt 2 ]]; then
          echo "airlock-claude: $1 needs a directory" >&2
          return 2
        fi
        if [[ $1 == --mount-rw ]]; then MOUNTS_RW+=("$2"); else MOUNTS_RO+=("$2"); fi
        shift ;;
      --mount-rw=*) MOUNTS_RW+=("${1#--mount-rw=}") ;;
      --mount-ro=*) MOUNTS_RO+=("${1#--mount-ro=}") ;;
      -x|--exec) EXEC=1 ;;
      -r|--rebuild) REBUILD=1 ;;
      -c|--remote-control) REMOTE_CONTROL=1 ;;
      -h|--help) SHOW_USAGE=1; break ;;
      *)
        echo "airlock-claude: unknown option: $1" >&2
        echo "Try 'airlock-claude --help'." >&2
        return 2 ;;
    esac
    shift
  done
}

validate_exec_usage() {
  local exec_given=$1 command_word_count=$2
  [[ -n $exec_given ]] || return 0
  if (( command_word_count == 0 )); then
    echo "airlock-claude: --exec needs a command after --" >&2
    return 2
  fi
}

require_airlock() {
  if ! command -v airlock >/dev/null 2>&1; then
    echo "airlock-claude: airlock not found in PATH" >&2
    return 1
  fi
}

own_pack_dir() {
  local script=$1
  local link dir
  while link=$(readlink -- "$script"); do
    [[ $link == /* || $script != */* ]] || link=${script%/*}/$link
    script=$link
  done
  if [[ $script == */* ]]; then dir=${script%/*}; else dir=.; fi
  dir=$(CDPATH= cd -- "${dir:-/}" 2>/dev/null && pwd) || return 0
  [[ -f $dir/packs/airlock-claude/pack.toml ]] && printf '%s\n' "$dir/packs/airlock-claude"
  return 0
}

install_user_pack() {
  local own_pack=$1 user_pack=$2
  local file
  if [[ -z $own_pack ]]; then
    [[ -f $user_pack/pack.toml && ! -L $user_pack ]] && return 0
    echo "airlock-claude: the airlock-claude pack is not installed in $user_pack: run airlock-claude once from its repository checkout, which installs it" >&2
    return 1
  fi
  if [[ -L $user_pack || ( -e $user_pack && ! -d $user_pack ) ]]; then
    rm -f -- "$user_pack" || { echo "airlock-claude: could not replace $user_pack" >&2; return 1; }
  fi
  mkdir -p -- "$user_pack" || { echo "airlock-claude: could not create $user_pack" >&2; return 1; }
  for file in "$user_pack"/*; do
    [[ -e $file || -L $file ]] || continue
    [[ -f $own_pack/${file##*/} ]] && continue
    rm -rf -- "$file" || { echo "airlock-claude: could not remove $file" >&2; return 1; }
  done
  for file in "$own_pack"/*; do
    [[ -f $file ]] || continue
    cmp -s -- "$file" "$user_pack/${file##*/}" && continue
    rm -rf -- "$user_pack/${file##*/}" && cp -- "$file" "$user_pack/${file##*/}" || {
      echo "airlock-claude: could not copy $file to $user_pack" >&2
      return 1
    }
  done
}

resolve_extra_mount() {
  local flag=$1 dir=$2 read_only=$3
  local source target existing
  if [[ -z $dir ]]; then
    echo "airlock-claude: $flag needs a directory" >&2
    return 2
  fi
  if [[ ! -d $dir ]]; then
    echo "airlock-claude: $flag: not a directory: $dir" >&2
    return 2
  fi
  source=$(CDPATH= cd -- "$dir" 2>/dev/null && pwd) || {
    echo "airlock-claude: $flag: cannot resolve: $dir" >&2
    return 2
  }
  if [[ $source == *[[:cntrl:]]* ]]; then
    echo "airlock-claude: $flag: control characters in the path are not supported: $dir" >&2
    return 2
  fi
  if [[ $source == "$PWD" ]]; then
    echo "airlock-claude: $flag: $dir is the project directory, which is always mounted" >&2
    return 2
  fi
  target=${source##*/}
  if [[ -z $target ]]; then
    echo "airlock-claude: $flag: cannot mount the filesystem root" >&2
    return 2
  fi
  for existing in ${MOUNT_TARGETS[@]+"${MOUNT_TARGETS[@]}"}; do
    if [[ $existing == "$target" ]]; then
      echo "airlock-claude: two mounts would both appear as ./$target; rename one on the host" >&2
      return 2
    fi
  done
  MOUNT_SOURCES+=("$source")
  MOUNT_TARGETS+=("$target")
  MOUNT_READ_ONLY+=("$read_only")
}

resolve_extra_mounts() {
  MOUNT_SOURCES=() MOUNT_TARGETS=() MOUNT_READ_ONLY=()
  local dir
  for dir in ${MOUNTS_RW[@]+"${MOUNTS_RW[@]}"}; do
    resolve_extra_mount --mount-rw "$dir" false || return $?
  done
  for dir in ${MOUNTS_RO[@]+"${MOUNTS_RO[@]}"}; do
    resolve_extra_mount --mount-ro "$dir" true || return $?
  done
}

without_config_block() {
  local file=$1
  local line inside=
  [[ -f $file ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ -n $inside ]]; then
      if [[ $line == "# END airlock-claude config" ]]; then inside=; fi
    elif [[ $line == "# BEGIN airlock-claude config"* ]]; then
      inside=1
    else
      printf '%s\n' "$line"
    fi
  done < "$file" || return 1
  [[ -z $inside ]] || return 2
}

project_config_present() {
  local ext
  for ext in toml json yaml yml; do
    [[ -e airlock.$ext ]] && { printf '1\n'; return 0; }
  done
  for ext in json yaml yml; do
    [[ -e airlock.local.$ext ]] && { printf '1\n'; return 0; }
  done
  if [[ -f airlock.local.toml ]] && [[ -n $(without_config_block airlock.local.toml 2>/dev/null | tr -d '[:space:]') ]]; then
    printf '1\n'
  fi
  return 0
}

sandbox_dir() {
  airlock info --json 2>/dev/null | sed -n 's/^ *"dir": *"\(.*\)",\{0,1\}$/\1/p'
}

refuse_config_without_sandbox() {
  local mount_count=$1 remote_control=$2 rebuild=$3 sandbox=$4 has_config=$5
  if [[ -n $remote_control && ( -n $rebuild || -z $sandbox ) ]]; then
    echo "airlock-claude: --remote-control needs a sandbox to exist already, to keep its Claude Code directory in: run once without it, so airlock's setup wizard can create the sandbox" >&2
    return 2
  fi
  (( mount_count > 0 )) || return 0
  [[ -z $has_config ]] || return 0
  if [[ -n $rebuild || -z $sandbox ]]; then
    echo "airlock-claude: --mount-rw/--mount-ro need a sandbox to exist already: run once without mounts, so airlock's setup wizard can create it" >&2
    return 2
  fi
}

refuse_sandbox_without_pack() {
  local rebuild=$1 sandbox=$2 has_config=$3
  local config
  [[ -z $has_config && ( -n $rebuild || -z $sandbox ) ]] && return 0
  config=$(airlock config --format json) || {
    echo "airlock-claude: airlock config failed, so the sandbox could not be checked for the airlock-claude pack" >&2
    return 1
  }
  [[ $config == *'"~airlock-claude":'* ]] && return 0
  if [[ -n $has_config ]]; then
    echo "airlock-claude: the project's config does not select the airlock-claude pack: add \"~airlock-claude\" = {} under [packs] in airlock.local.toml" >&2
  else
    echo "airlock-claude: this sandbox was set up without the airlock-claude pack: run airlock-claude -r and select airlock-claude (local) in the setup wizard" >&2
  fi
  return 1
}

remove_sandbox_on_rebuild() {
  local rebuild=$1
  [[ -n $rebuild ]] || return 0
  if ! airlock remove --force >&2; then
    echo "airlock-claude: airlock remove failed, not launching on the old sandbox" >&2
    return 1
  fi
}

toml_escaped() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s\n' "$s"
}

extra_mounts_config() {
  (( ${#MOUNT_SOURCES[@]} > 0 )) || return 0
  local i source target
  for ((i = 0; i < ${#MOUNT_SOURCES[@]}; i++)); do
    source=$(toml_escaped "${MOUNT_SOURCES[i]}")
    target=$(toml_escaped "${MOUNT_TARGETS[i]}")
    printf '[mounts."%s"]\nsource = "%s"\ntarget = "%s"\nread_only = %s\n' \
      "$target" "$source" "$target" "${MOUNT_READ_ONLY[i]}"
  done
}

remote_control_config() {
  local remote_control=$1 sandbox=$2
  [[ -n $remote_control ]] || return 0
  local claude_dir
  claude_dir=$(toml_escaped "$sandbox/remote-control-claude")
  printf '[network.services]\nanthropic = false\n\n'
  printf '[network.rules.airlock-claude-sign-in]\nallow = ["platform.claude.com:443"]\n\n'
  printf '[mounts.claude-dir]\nsource = "%s"\ntarget = "~/.claude"\nmissing = "create-dir"\n' "$claude_dir"
}

config_block() {
  local mounts=$1 remote_control=$2
  local body=$mounts
  [[ -n $remote_control ]] && body=${body:+$body$'\n\n'}$remote_control
  [[ -n $body ]] || return 0
  printf '# BEGIN airlock-claude config (rewritten on every airlock-claude run)\n%s\n# END airlock-claude config\n' "$body"
}

write_config_block() {
  local block=$1
  local kept= content status
  if [[ -e airlock.local.toml ]]; then
    kept=$(without_config_block airlock.local.toml 2>/dev/null); status=$?
    if (( status == 2 )); then
      echo "airlock-claude: airlock.local.toml has a '# BEGIN airlock-claude config' line without its '# END airlock-claude config' line; fix or remove the block by hand" >&2
      return 1
    elif (( status != 0 )); then
      echo "airlock-claude: could not read airlock.local.toml in $PWD" >&2
      return 1
    fi
    if [[ -z $block && $kept == "$(cat airlock.local.toml)" ]]; then
      return 0
    fi
  fi
  content=$kept
  [[ -n $block ]] && content=${content:+$content$'\n\n'}$block
  if [[ -z $(printf '%s' "$content" | tr -d '[:space:]') ]]; then
    [[ -e airlock.local.toml ]] && rm -f airlock.local.toml
    return 0
  fi
  printf '%s\n' "$content" > airlock.local.toml || {
    echo "airlock-claude: could not write airlock.local.toml in $PWD" >&2
    return 1
  }
}

keep_previous_pty_dump() {
  local dump=$1
  if [[ -s $dump ]]; then
    mv -f "$dump" "$dump.previous"
  fi
}

session_script() {
  local use_tmux=$1 remote_control=$2
  cat <<'PACK_CHECK'
if [ ! -f /etc/claude-code/managed-settings.json ]; then
  echo "airlock-claude: this sandbox has no airlock-claude pack install: run airlock-claude -r and select airlock-claude (local) in the setup wizard" >&2
  exit 1
fi
PACK_CHECK
  if [[ -n $remote_control ]]; then
    cat <<'REMOTE_CONTROL'
unset CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
REMOTE_CONTROL
  fi
  if [[ -n $use_tmux ]]; then
    cat <<'HANDOFF'
exec tmux -u new-session -A -s claude "$(printf '%q ' "$@")"
HANDOFF
  else
    cat <<'HANDOFF'
exec "$@"
HANDOFF
  fi
}

strip_terminal_escapes() {
  local esc=$'\033' bel=$'\007'
  LC_ALL=C tr -d '\000' \
    | LC_ALL=C tr '\r' '\n' \
    | LC_ALL=C sed -E \
        -e "s/${esc}\][^${bel}${esc}]*(${bel}|${esc}\\\\)?//g" \
        -e "s/${esc}[PX^_][^${esc}]*(${esc}\\\\)?//g" \
        -e "s/${esc}\[[^@-~]*[@-~]//g" \
        -e "s/${esc}[()][0-9A-Za-z]//g" \
        -e "s/${esc}.//g" \
    | LC_ALL=C tr -d '\001-\010\013\014\016-\037\177'
}

print_pty_dump_tail() {
  local dump=$1 max_lines=$2
  [[ -s $dump ]] || return 0
  local last_lines
  last_lines=$(tail -c 65536 "$dump" | strip_terminal_escapes \
    | LC_ALL=C sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -n "$max_lines")
  [[ -n $last_lines ]] || return 0
  printf 'airlock-claude: last session output (whole log: %s):\n' "$dump"
  printf '%s\n' "$last_lines" | sed 's/^/  /'
}

parse_args "$@" || exit $?
[[ -n $SHOW_USAGE ]] && { usage; exit 0; }

validate_exec_usage "$EXEC" "${#CLAUDE_ARGS[@]}" || exit $?

require_airlock || exit 1

install_user_pack "$(own_pack_dir "${BASH_SOURCE[0]}")" "$HOME/.airlock/packs/airlock-claude" || exit 1

resolve_extra_mounts || exit $?
refuse_config_without_sandbox "${#MOUNT_SOURCES[@]}" "$REMOTE_CONTROL" "$REBUILD" "$(sandbox_dir)" "$(project_config_present)" || exit $?
refuse_sandbox_without_pack "$REBUILD" "$(sandbox_dir)" "$(project_config_present)" || exit 1

remove_sandbox_on_rebuild "$REBUILD" || exit 1

CONFIG_BLOCK=$(config_block "$(extra_mounts_config)" "$(remote_control_config "$REMOTE_CONTROL" "$(sandbox_dir)")")
write_config_block "$CONFIG_BLOCK" || exit 1

SANDBOX_DIR=$(sandbox_dir)
[[ -n $SANDBOX_DIR ]] && keep_previous_pty_dump "$SANDBOX_DIR/pty.dump"

SESSION_SCRIPT=$(session_script "$USE_TMUX" "$REMOTE_CONTROL")
if [[ -n $EXEC ]]; then
  SESSION_COMMAND=("${CLAUDE_ARGS[@]}")
else
  SESSION_COMMAND=(claude "${CLAUDE_ARGS[@]}")
fi

AIRLOCK_PTY_DUMP=1 airlock start ${MONITOR:+--monitor} --network deny-by-default -- bash -c "$SESSION_SCRIPT" airlock-claude "${SESSION_COMMAND[@]}"
AIRLOCK_EXIT=$?

SANDBOX_DIR=$(sandbox_dir)
[[ -n $SANDBOX_DIR ]] && print_pty_dump_tail "$SANDBOX_DIR/pty.dump" 15 >&2
exit "$AIRLOCK_EXIT"
