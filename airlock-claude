#!/bin/bash

IMAGE=airlock-claude:latest

usage() {
  cat <<'USAGE'
Usage: airlock-claude [-r|--rebuild-image] [-h|--help]

Runs Claude Code sandboxed in an airlock VM in the current directory,
building the sandbox image and generating airlock config as needed.

  -r, --rebuild-image  Rebuild the sandbox image from scratch, ignoring the
                       layer cache and re-pulling the base image, and drop
                       the local .airlock directory so airlock converts the
                       refreshed image instead of its cached VM disk.
  -h, --help           Show this help.
USAGE
}

# Sets REBUILD for the two steps that consult it. Nothing is forwarded to
# claude — the launch line at the bottom is fixed.
parse_args() {
  REBUILD=
  while [[ $# -gt 0 ]]; do
    case $1 in
      -r|--rebuild-image) REBUILD=1 ;;
      -h|--help) usage; exit 0 ;;
      *)
        echo "airlock-claude: unknown option: $1" >&2
        echo "Try 'airlock-claude --help'." >&2
        exit 2 ;;
    esac
    shift
  done
}

# Sets OCI, and on the podman path also SHIM_DIR and PATH. Those stay global:
# the EXIT trap below fires long after this function has returned, and needs
# SHIM_DIR still set to clean up.
pick_container_engine() {
  # airlock always shells out to a literal `docker` command, so when only podman
  # is available it gets a shim that forwards to podman.
  if command -v docker >/dev/null 2>&1; then
    OCI=docker
  elif command -v podman >/dev/null 2>&1; then
    OCI=podman
    SHIM_DIR=$(mktemp -d) || exit 1
    trap 'rm -rf "$SHIM_DIR"' EXIT
    printf '#!/bin/sh\nexec podman "$@"\n' > "$SHIM_DIR/docker"
    chmod +x "$SHIM_DIR/docker"
    export PATH="$SHIM_DIR:$PATH"
  else
    echo "Neither docker nor podman found in PATH" >&2
    exit 1
  fi
}

build_image_if_needed() {
  if [[ -z $REBUILD ]] && "$OCI" image inspect "$IMAGE" >/dev/null 2>&1; then
    return 0
  fi

  echo "Building $IMAGE with $OCI ..." >&2
  # A cached rebuild would hand back the very same layers, so `-r` throws away
  # the layer cache and re-pulls the base image — otherwise "rebuild" wouldn't
  # pick up a new Claude Code install or newer apt packages.
  local build_flags=()
  [[ -n $REBUILD ]] && build_flags=(--no-cache --pull)
  # Bake the host's git identity into the image so commits made inside the VM
  # are attributed correctly. `git config --list --includes` prints entries in
  # increasing precedence order, so the last occurrence of each key is the
  # effective one. Either may be empty (no identity configured on the host).
  local git_list git_user_name git_user_email
  git_list=$(git config --list --includes 2>/dev/null)
  git_user_name=$(printf '%s\n' "$git_list" | sed -n 's/^user\.name=//p' | tail -1)
  git_user_email=$(printf '%s\n' "$git_list" | sed -n 's/^user\.email=//p' | tail -1)
  "$OCI" build -t "$IMAGE" "${build_flags[@]}" \
    --build-arg "GIT_USER_NAME=$git_user_name" \
    --build-arg "GIT_USER_EMAIL=$git_user_email" - <<'DOCKERFILE' || exit 1
FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git curl ripgrep jq less procps unzip openssh-client \
 && rm -rf /var/lib/apt/lists/*

# Claude Code is installed into the image rather than bind-mounted from the
# host: the host binary is built for the host OS, so a macOS `claude` cannot
# run inside the Linux VM. It goes under a fixed HOME so the launcher path
# doesn't depend on which user the VM ends up running as, and is left
# world-writable so a non-root VM user can still update it.
ENV CLAUDE_INSTALL_HOME=/opt/claude
# Appended, not prepended: /usr/local/bin stays ahead so `claude` resolves to
# the self-updating wrapper below, but the install dir being on PATH at all
# stops Claude Code warning about it on every update.
ENV PATH="$PATH:/opt/claude/.local/bin"
RUN mkdir -p "$CLAUDE_INSTALL_HOME" \
 && HOME="$CLAUDE_INSTALL_HOME" sh -c 'curl -fsSL https://claude.ai/install.sh | bash' \
 && chmod -R a+rwX "$CLAUDE_INSTALL_HOME"

# `claude` on PATH is a wrapper that updates in place before handing off, so a
# new Claude Code release doesn't need an image rebuild. The update endpoint
# (downloads.claude.ai) is already allowed by airlock's claude-code preset.
# HOME is overridden for the update only, so the updater resolves the image's
# install instead of the VM user's home; the session itself keeps the real HOME
# (that's where airlock mounts ~/.claude and ~/.claude.json).
RUN printf '%s\n' \
      '#!/bin/sh' \
      'LAUNCHER="${CLAUDE_INSTALL_HOME:-/opt/claude}/.local/bin/claude"' \
      'STAMP=/tmp/.airlock-claude-updated' \
      '# Update once per VM boot: nested `claude` calls must not swap the' \
      '# binary out from under a running session.' \
      'if [ -z "$AIRLOCK_CLAUDE_SKIP_UPDATE" ] && [ ! -e "$STAMP" ]; then' \
      '  : > "$STAMP" 2>/dev/null' \
      '  HOME="${CLAUDE_INSTALL_HOME:-/opt/claude}" "$LAUNCHER" update >&2 ||' \
      '    echo "airlock-claude: update failed, using the version from the image" >&2' \
      'fi' \
      'exec "$LAUNCHER" "$@"' \
      > /usr/local/bin/claude \
 && chmod +x /usr/local/bin/claude

# The host's git identity, captured at build time. Written to /etc/gitconfig
# (git's system-level config) rather than a home directory, so it applies
# whichever user the VM runs as; a real ~/.gitconfig in the mounted home still
# takes precedence. Kept last so changing identity doesn't invalidate the
# cached layers above. `git config` handles quoting, so odd characters in a
# name are safe. Either value may be empty if the host has no identity set.
ARG GIT_USER_NAME=
ARG GIT_USER_EMAIL=
RUN if [ -n "$GIT_USER_NAME" ]; then git config --system user.name "$GIT_USER_NAME"; fi \
 && if [ -n "$GIT_USER_EMAIL" ]; then git config --system user.email "$GIT_USER_EMAIL"; fi
DOCKERFILE
}

# airlock caches the VM disk it converts from the OCI image under .airlock, so
# a freshly built image goes unused until that cache is gone.
drop_vm_cache_on_rebuild() {
  if [[ -n $REBUILD ]]; then
    rm -rf .airlock
  fi
}

generate_airlock_config() {
  # airlock only passes through what the config names, so the host's opt-out has
  # to be written in to reach the VM. Built here and expanded inside [env] below
  # rather than appended after the heredoc: an appended key joins whatever table
  # ends up last, so adding a table below [env] would silently move it out and
  # stop the opt-out working.
  local skip_update_line=
  if [[ -n ${AIRLOCK_CLAUDE_SKIP_UPDATE:-} ]]; then
    skip_update_line='AIRLOCK_CLAUDE_SKIP_UPDATE = "1"'
  fi

  # A failed write must not fall through to the launch: airlock would start on
  # whatever airlock.local.toml a previous run left in this directory, or on its
  # own defaults, and the deny-by-default policy this script exists to impose
  # would silently not be the one in effect.
  if ! cat > airlock.local.toml <<EOF
presets = ["claude-code"]

[network]
policy = "deny-by-default"

[vm.image]
name = "$IMAGE"
resolution = "docker"

[env]
# The image's claude wrapper updates at startup, so the background autoupdater
# would only duplicate that work mid-session.
DISABLE_AUTOUPDATER = "1"
$skip_update_line
EOF
  then
    echo "airlock-claude: could not write airlock.local.toml in $PWD" >&2
    exit 1
  fi
}

# airlock hardlinks files out of HOME into its per-directory state, and a
# hardlink can't cross a filesystem boundary — including a btrfs subvolume
# boundary, which is one filesystem to the mount table but not to link(2).
# Pointing HOME at the filesystem root of the working directory puts it on the
# same filesystem as the state being linked into, so the links can be made.
redirect_home_for_exotic_fs() {
  local df_bin fs_root
  df_bin="$(command -v gdf || command -v df)" || {
    echo "Neither gdf nor df found in PATH" >&2
    exit 1
  }
  # `--output` is GNU-only — BSD df rejects it, so a Mac without coreutils' gdf
  # gets no answer here. Requiring the result to look like an absolute path keeps
  # that case a no-op: an unguarded assignment would export an empty HOME and
  # send airlock looking for ~/.claude somewhere that doesn't exist.
  fs_root=$("$df_bin" --output=target . 2>/dev/null | tail -1)
  if [[ $fs_root == /* && $fs_root != "/" && $fs_root != "/home" ]]; then
    export HOME=$fs_root
  fi
}

parse_args "$@"
pick_container_engine
build_image_if_needed
drop_vm_cache_on_rebuild
generate_airlock_config
redirect_home_for_exotic_fs

airlock start --monitor -- claude --dangerously-skip-permissions --remote-control
